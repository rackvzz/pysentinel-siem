# Copy this file to secrets.yaml (which is gitignored -- never commit
# real API keys) and fill in your own values.

# Get a free Auth-Key by signing in at https://auth.abuse.ch/ with an
# existing Google/GitHub/LinkedIn/X account. Required for the
# threat_intel feature in config.yaml to actually fetch anything.
threatfox_api_key: "YOUR_AUTH_KEY_HERE"
